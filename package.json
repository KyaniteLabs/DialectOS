{
  "name": "dialectos",
  "version": "0.3.0",
  "private": true,
  "description": "Spanish dialect localization MCP server and CLI for 25 regional variants, glossary enforcement, structure preservation, and QA gates.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "node scripts/build-demo.cjs --check && node --test docs/__tests__/*.test.mjs scripts/__tests__/*.test.mjs && pnpm -r test",
    "check:generated": "node scripts/build-demo.cjs --check",
    "demo": "pnpm build && node scripts/demo-server.mjs",
    "test:coverage": "pnpm -r test:coverage",
    "clean": "pnpm -r clean",
    "dialect:eval": "node scripts/dialect-eval.mjs",
    "dialect:certify": "node scripts/dialect-certify.mjs",
    "dialect:certify:adversarial": "node scripts/dialect-certify-adversarial.mjs",
    "dialect:certify:documents": "node scripts/dialect-certify-documents.mjs",
    "dialect:report": "node scripts/dialect-report.mjs",
    "dialect:research": "node packages/cli/dist/index.js research-regional-term",
    "launch:gate": "node scripts/launch-gate.mjs"
  },
  "keywords": [
    "spanish",
    "spanish-localization",
    "latam-spanish",
    "translation",
    "i18n",
    "localization",
    "mcp",
    "model-context-protocol",
    "cli",
    "dialect",
    "regional-spanish",
    "dialect-translation",
    "es-mx",
    "es-ar",
    "es-co",
    "es-es",
    "markdown-translation",
    "locale-utils",
    "glossary",
    "formality",
    "gender-neutral",
    "ai-tools",
    "llm-tools",
    "mcp-server",
    "translation-qa",
    "typescript",
    "deepl",
    "libretranslate",
    "mymemory"
  ],
  "license": "BSL-1.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/KyaniteLabs/DialectOS.git"
  },
  "bugs": {
    "url": "https://github.com/KyaniteLabs/DialectOS/issues"
  },
  "homepage": "https://kyanitelabs.github.io/DialectOS/",
  "pnpm": {
    "overrides": {
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2 <8.0.0",
      "vite@>=7.1.0 <=7.3.1": ">=7.3.2 <8.0.0",
      "hono@<4.12.18": ">=4.12.18",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "follow-redirects@<=1.15.11": ">=1.16.0",
      "dompurify@<=3.3.3": ">=3.4.0",
      "fast-uri@<=3.1.1": ">=3.1.2",
      "ip-address@<=10.1.0": ">=10.1.1",
      "axios@>=1.0.0 <1.15.0": ">=1.15.0",
      "qs@>=6.11.1 <=6.15.1": "6.15.2"
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.7"
  }
}
